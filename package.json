{
  "name": "musicd",
  "version": "1.0.0",
  "description": "Self-hosted music streaming CLI",
  "type": "module",
  "bin": {
    "musicd": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/cli/index.ts serve --port 3001",
    "dev:web": "vite",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc",
    "build:web": "vite build",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "commander": "^12.1.0",
    "fastify": "^4.28.1",
    "music-metadata": "^10.2.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
